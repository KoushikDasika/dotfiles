# Qwen3.6-27B NVFP4 (unsloth) via Atlas Spark — serves OpenAI-compatible API on localhost:8888
spark-nvfp4:
    sparkrun run @atlas/qwen3.6-27b-nvfp4-unsloth --hosts localhost

