# Global justfile — run from anywhere with:  just -g <module> <recipe>
# List recipes:  just -g
#
# Modules are hardware-gated: the dotfiles `symlinks` recipe only links the
# module files relevant to this machine (GB10/DGX Spark vs 24GB laptop), and
# `mod?` silently skips whatever isn't linked. See dotfiles justfile `symlinks`.

llama_bench := home_directory() / "git/llama.cpp/build/bin/llama-bench"

mod? atlas    # sparkrun @atlas registry recipes (DGX Spark)
mod? sparkrun # sparkrun local-YAML recipes (ai/sparkrun-recipes/)
mod? llama    # llama.cpp recipes (DGX Spark)
mod? vllm     # vLLM recipes (DGX Spark)
mod? qwen38   # Qwen3.8-27B landing pad (drops 2026-08-12)
mod? server   # server management (DGX Spark systemd services)
mod? rtx5090  # legacy 24GB RTX 5090 laptop recipes

# show available recipes
default:
    @just -g --list

# daily driver: Atlas 35B-A3B FP8+MTP flagship, 256K ctx, port 8888
up:
    @just -g atlas a3b

# stop all sparkrun workloads on this box
down:
    sparkrun stop --all --hosts localhost

# show running sparkrun containers
status:
    sparkrun status --hosts localhost

# benchmark any local gguf (pp512 + tg128)
bench model:
    {{llama_bench}} -m {{model}} -ngl 99 -fa 1

# ── Boot target ─────────────────────────────────────────────────────────────

# Headless now + on next reboot (GUI off; sshd/tailscaled/llama keep running).
# Run from tmux or SSH — a GUI terminal dies with the display.
headless:
    sudo systemctl set-default multi-user.target
    sudo systemctl isolate multi-user.target
    @echo "default target: $(systemctl get-default)"

# GUI now + on next reboot
gui:
    sudo systemctl set-default graphical.target
    sudo systemctl isolate graphical.target
    @echo "default target: $(systemctl get-default)"
