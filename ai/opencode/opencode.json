{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/RTK.md",
    "~/.config/opencode/caveman.md"
  ],
  "mcp": {
    "mempalace": {
      "type": "local",
      "command": ["mempalace-mcp"],
      "enabled": true
    },
    "atlassian": {
      "url": "https://gateway.truefoundry.ai/automatiq/mcp/atlassian/server",
      "type": "remote",
      "enabled": true,
      "timeout": 60000
    },
    "fellow": {
      "url": "https://gateway.truefoundry.ai/automatiq/mcp/fellow/server",
      "type": "remote",
      "enabled": true,
      "timeout": 60000
    },
    "slack": {
      "url": "https://gateway.truefoundry.ai/automatiq/mcp/slack/server",
      "type": "remote",
      "enabled": true,
      "timeout": 60000
    },
    "posthog": {
      "url": "https://gateway.truefoundry.ai/automatiq/mcp/posthog/server",
      "type": "remote",
      "enabled": false,
      "timeout": 60000
    },
    "b2b": {
      "url": "https://gateway.truefoundry.ai/automatiq/mcp/b2b-mcp/server",
      "type": "remote",
      "enabled": true,
      "timeout": 60000
    }
  },
  "skills": {
    "paths": ["~/.config/opencode/skills"]
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-mem",
    "opencode-plan-manager",
    "~/.config/opencode/plugins/mem-recall.js",
    "~/.config/opencode/plugins/phx-hooks.js",
    "~/.config/opencode/plugins/rtk.js"
  ],
  "provider": {
    "truefoundry": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TrueFoundry",
      "options": {
        "baseURL": "https://gateway.truefoundry.ai",
        "headers": {},
        "includeUsage": true,
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true
      },
      "models": {
        "automatiq-claude/haiku": {
          "name": "Haiku",
          "cost": {
            "input": 1.0,
            "output": 5.0
          }
        },
        "automatiq-prod-datateam/sonnet-4.6": {
          "name": "Sonnet 4.6",
          "cost": {
            "input": 3.0,
            "output": 15.0
          }
        },
        "automatiq-claude/opus": {
          "name": "Opus 4.6",
          "cost": {
            "input": 5.0,
            "output": 25.0
          }
        },
        "automatiq-openai/openai-astra-6": {
          "name": "Astra 6",
          "cost": {
            "input": 10.0,
            "output": 50.0
          }
        },
        "automatiq-openai/openai-sol-5-6": {
          "name": "Sol 5.6",
          "cost": {
            "input": 5.5,
            "output": 33
          }
        },
        "automatiq-openai/openai-terra-5-6": {
          "name": "Terra 5.6",
          "cost": {
            "input": 2.2,
            "output": 13.2
          }
        },
        "automatiq-xai/XAI-grok-4-6": {
          "name": "Grok 4.6",
          "cost": {
            "input": 2.0,
            "output": 6.0
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "low": {
              "reasoningEffort": "low"
            }
          }
        }
      }
    },
    "atlas-spark": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Atlas Spark (sparkrun, DGX Spark)",
      "options": {
        "baseURL": "https://hooray-engine1.tail5e55e1.ts.net/v1"
      },
      "models": {
        "@atlas/qwen3.6-35b-a3b-fp8-mtp": {
          "name": "Qwen3.6-35B-A3B FP8+MTP — flagship (just -g up)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "@atlas/qwen3.6-35b-a3b-nvfp4": {
          "name": "Qwen3.6-35B-A3B NVFP4 — fastest, ~116 t/s (just -g atlas a3b-nvfp4)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "@atlas/qwen3.6-27b-fp8-mtp": {
          "name": "Qwen3.6-27B FP8+MTP — smartest dense (just -g atlas dense)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "@atlas/qwen3.6-27b-nvfp4": {
          "name": "Qwen3.6-27B NVFP4 — lighter dense (just -g atlas dense-nvfp4)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "qwen3.8-27b-bf16": {
          "name": "Qwen3.8-27B BF16 — max quality, DGX Spark only (just -g qwen38 dense-bf16)",
          "limit": {
            "context": 200000,
            "output": 32768
          }
        }
      }
    },
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3.6-35b-a3b-q8": {
          "name": "Qwen3.6-35B-A3B UD-Q8_K_XL+MTP (just -g llama a3b-q8)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "qwen3.6-35b-a3b-bf16": {
          "name": "Qwen3.6-35B-A3B BF16+MTP (just -g llama a3b-bf16)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "qwen3.6-27b-q8": {
          "name": "Qwen3.6-27B UD-Q8_K_XL+MTP (just -g llama dense-q8)",
          "limit": {
            "context": 200000,
            "output": 32768
          }
        },
        "qwen3.6-27b-bf16": {
          "name": "Qwen3.6-27B BF16+MTP (just -g llama dense-bf16)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "qwen3.6-35b-a3b-q4": {
          "name": "Qwen3.6-35B-A3B UD-Q4_K_XL+MTP, RTX 5090 laptop (just -g rtx5090 qwen-wide)",
          "limit": {
            "context": 81920,
            "output": 32768
          }
        },
        "qwen3.6-27b-q4": {
          "name": "Qwen3.6-27B UD-Q4_K_XL+MTP, RTX 5090 laptop (just -g rtx5090 qwen-dense-150k)",
          "limit": {
            "context": 153600,
            "output": 32768
          }
        },
        "gemma-4-12b-qat": {
          "name": "gemma-4-12B QAT+MTP, RTX 5090 laptop (just -g rtx5090 gemma)",
          "limit": {
            "context": 200000,
            "output": 32768
          }
        },
        "gemma-4-12b-agentic-ft": {
          "name": "gemma-4-12B agentic fine-tune Q8+MTP, RTX 5090 laptop (just -g rtx5090 gemma-ft)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "qwen3.8-27b-q4": {
          "name": "Qwen3.8-27B UD-Q4_K_XL (just -g qwen38 serve / just -g rtx5090 qwen38)",
          "limit": {
            "context": 200000,
            "output": 32768
          }
        }
      }
    },
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM (local, port 8000)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "/home/halcyonicstorm/git/models/Qwen3.6-27B-NVFP4-unsloth": {
          "name": "Qwen3.6-27B NVFP4 unsloth (just -g vllm dense-nvfp4-unsloth)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "/home/halcyonicstorm/git/models/Qwen3.6-27B-NVFP4-nvidia": {
          "name": "Qwen3.6-27B NVFP4 nvidia (just -g vllm dense-nvfp4-nvidia)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "/home/halcyonicstorm/git/models/Qwen3.8-27B-NVFP4-unsloth": {
          "name": "Qwen3.8-27B NVFP4 unsloth (just -g rtx5090 qwen38-nvfp4)",
          "limit": {
            "context": 20480,
            "output": 8192
          }
        }
      }
    }
  }
}
