{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/RTK.md",
    "~/.config/opencode/caveman.md"
  ],
  "mcp": {
    "mempalace": {
      "type": "local",
      "command": ["mempalace-mcp"],
      "enabled": true
    }
  },
  "skills": {
    "paths": ["~/.config/opencode/skills"]
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-mem",
    "opencode-plan-manager",
    "~/.config/opencode/node_modules/phx-hooks",
    "~/.config/opencode/node_modules/rtk-rewriter"
  ],
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8888/v1"
      },
      "models": {
        "qwen3.6-35b-a3b-mtp-gguf": {
          "name": "Qwen3.6-35B-A3B-MTP-GGUF:UD-Q4_K_XL",
          "limit": {
            "context": 81920,
            "output": 128000
          }
        }
      }
    },
    "atlas-spark": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Atlas Spark (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8888/v1"
      },
      "models": {
        "@atlas/qwen3.6-27b-fp8-mtp": {
          "name": "Qwen3.6-27B FP8+MTP (Atlas Spark)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "@atlas/qwen3.6-27b-nvfp4-unsloth": {
          "name": "Qwen3.6-27B NVFP4 unsloth (Atlas Spark)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  }
}
