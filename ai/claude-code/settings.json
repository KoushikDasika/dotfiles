{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-6[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6[1m]",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "333000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "95"
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(bd create:*)",
      "Bash(bd:*)",
      "Bash(bd update:*)",
      "Bash(bd close:*)",
      "Bash(bd list:*)",
      "Bash(bd ready:*)",
      "Bash(bd show:*)",
      "Bash(bd sync:*)",
      "Bash(bd stats:*)",
      "Bash(bd blocked:*)",
      "Bash(bd dep add:*)",
      "Bash(bd prime:*)",
      "Bash(docker compose:*)",
      "Bash(docker compose exec:*)",
      "Bash(git diff:*)",
      "Bash(git mv:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "WebFetch(domain:hexdocs.pm)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.opensearch.org)",
      "WebFetch(domain:daisyui.com)",
      "WebSearch",
      "mcp__voicemode__converse",
      "mcp__voicemode__service",
      "mcp__postgres__*",
      "mcp__mcp-agent-mail__*"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/halcyonicstorm/.claude/track-active-context.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/halcyonicstorm/.claude/track-active-context.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/halcyonicstorm/.claude/track-active-context.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/halcyonicstorm/.claude/track-active-context.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"/home/halcyonicstorm/.claude/statusline.mjs\""
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "elixir-phoenix@oliver-kriska": true,
    "mempalace@mempalace": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "lv@oliver-kriska": true,
    "ecto@oliver-kriska": true,
    "beads@beads-marketplace": true
  },
  "extraKnownMarketplaces": {
    "oliver-kriska": {
      "source": {
        "source": "github",
        "repo": "oliver-kriska/claude-elixir-phoenix"
      },
      "autoUpdate": true
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      },
      "autoUpdate": true
    },
    "beads-marketplace": {
      "source": {
        "source": "github",
        "repo": "steveyegge/beads"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "mempalace": {
      "source": {
        "source": "github",
        "repo": "MemPalace/mempalace"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "auto",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false,
  "mcpServers": {}
}
